<script>
(function(){
  var btn=document.getElementById('menuBtn');
  var menu=document.getElementById('mobileMenu');
  if(btn&&menu){ btn.onclick=function(){ menu.classList.toggle('open'); }; }
  // realtime-ish notifications (poll)
  var badge=document.getElementById('notifBadge');
  if(badge){
    function poll(){
      fetch('/api/notifications/unread',{credentials:'same-origin'})
        .then(function(r){ return r.json(); })
        .then(function(d){
          if(d&&d.count>0){ badge.style.display='flex'; badge.textContent=d.count>9?'9+':d.count; }
          else { badge.style.display='none'; }
        }).catch(function(){});
    }
    poll();
    setInterval(poll, 8000);
  }
})();
</script>
