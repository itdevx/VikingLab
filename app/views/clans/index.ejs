<%- include('../partials/header') %>
<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold mb-1">⚔️ کلَن‌ها</h1>
    <p class="text-sm text-gray-400">درخواست عضویت → تأیید لیدر · جنگ با حل همان Labها</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/clans/notifications" class="relative border border-raven-600 px-4 py-2 rounded-xl text-sm hover:border-indigo-500/40">
      اعلان‌ها
      <% if (unread) { %><span class="absolute -top-1 -left-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center"><%= unread %></span><% } %>
    </a>
    <a href="/clans/requests" class="border border-amber-500/40 text-amber-300 px-4 py-2 rounded-xl text-sm">درخواست‌ها (لیدر)</a>
    <a href="/clans/leaderboard" class="border border-amber-500/40 text-amber-300 px-4 py-2 rounded-xl text-sm">لیدربورد</a>
    <a href="/clans/wars" class="border border-red-500/40 text-red-300 px-4 py-2 rounded-xl text-sm">جنگ‌ها</a>
    <% if (!myClan) { %>
      <a href="/clans/create" class="bg-amber-600 hover:bg-amber-500 text-white px-5 py-2 rounded-xl text-sm font-medium">+ ساخت کلَن</a>
    <% } %>
  </div>
</div>
<% if (error) { %><div class="mb-4 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-sm"><%= error %></div><% } %>
<% if (success === 'requested') { %><div class="mb-4 p-3 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-300 text-sm">درخواست عضویت ارسال شد. منتظر تأیید لیدر کلَن بمان.</div><% } %>
<% if (success && success !== 'requested') { %><div class="mb-4 p-3 rounded-xl bg-green-500/10 border border-green-500/30 text-green-300 text-sm">انجام شد</div><% } %>

<% if (myClan) { %>
<div class="bg-gradient-to-l from-amber-600/20 to-orange-600/10 border border-amber-500/30 rounded-2xl p-6 mb-8">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-3xl"><%= myClan.badge || '⚔️' %></div>
      <div>
        <div class="text-xs text-amber-400/80">کلَن تو</div>
        <h2 class="text-2xl font-bold"><%= myClan.name %> <span class="text-amber-400 font-mono text-base">#<%= myClan.tag %></span></h2>
        <p class="text-sm text-gray-400">سطح <%= myClan.level || 1 %> · <%= myClan.trophies || 0 %> جام · <%= (myClan.member_ids||[]).length %> عضو</p>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/clans/<%= myClan.id %>" class="bg-amber-600 hover:bg-amber-500 text-white px-4 py-2 rounded-xl text-sm">مشاهده</a>
      <a href="/clans/leaderboard" class="border border-amber-500/40 text-amber-300 px-4 py-2 rounded-xl text-sm">لیدربورد</a>
    <a href="/clans/wars" class="border border-red-500/40 text-red-300 px-4 py-2 rounded-xl text-sm">جنگ</a>
      <form method="POST" action="/clans/leave" onsubmit="return confirm('ترک کلَن؟')"><button class="border border-red-500/40 text-red-300 px-4 py-2 rounded-xl text-sm">ترک</button></form>
    </div>
  </div>
</div>
<% } %>

<h2 class="text-lg font-semibold mb-4">رتبه‌بندی</h2>
<div class="space-y-3">
  <% if (!clans.length) { %><div class="bg-raven-900 border border-raven-700 rounded-2xl p-10 text-center text-gray-500">کلَنی نیست — یکی بساز</div><% } %>
  <% clans.forEach((c, i) => { %>
    <div class="bg-raven-900 border border-raven-700 hover:border-amber-500/40 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-xl bg-raven-800 flex items-center justify-center font-bold text-amber-400"><%= i+1 %></div>
        <span class="text-2xl"><%= c.badge || '⚔️' %></span>
        <div>
          <a href="/clans/<%= c.id %>" class="font-semibold hover:text-amber-300"><%= c.name %></a>
          <div class="text-xs text-gray-500">#<%= c.tag %> · سطح <%= c.level||1 %> · <%= c.memberCount %> عضو</div>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-amber-400 font-bold"><%= c.trophies||0 %> 🏆</span>
        <% if (!myClan) { %>
          <form method="POST" action="/clans/join/<%= c.id %>">
            <button class="text-sm bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-1.5 rounded-lg">درخواست عضویت</button>
          </form>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>
<%- include('../partials/footer') %>
