<%- include('../partials/header') %>
<div class="max-w-sm mx-auto">
  <div class="vk-card">
    <h1 class="text-xl font-bold text-center mb-6 vk-brand-gold">ورود به Viking Lab</h1>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 text-sm p-3 rounded-lg border border-red-500/40 text-red-300"><%= error %></div>
    <% } %>
    <form method="POST" action="/auth/login" class="space-y-3">
      <div>
        <label class="text-xs" style="color:var(--vk-muted)">ایمیل</label>
        <input type="email" name="email" required class="vk-input mt-1" autocomplete="username">
      </div>
      <div>
        <label class="text-xs" style="color:var(--vk-muted)">رمز عبور</label>
        <input type="password" name="password" required class="vk-input mt-1" autocomplete="current-password">
      </div>
      <button type="submit" class="vk-btn vk-btn-gold w-full mt-2">ورود</button>
    </form>
    <p class="text-center text-xs mt-4" style="color:var(--vk-muted)">
      حساب نداری؟ <a href="/auth/register" style="color:var(--vk-gold)">ثبت‌نام</a>
    </p>
  </div>
</div>
<%- include('../partials/footer') %>
